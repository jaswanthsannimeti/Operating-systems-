1ST QUESTION

#include <stdio.h>

int main()
{
    int n,f,m,i,start,ok;

    scanf("%d%d%d",&n,&f,&m);

    if(m==1)
    {
        ok=0;

        for(start=0;start<=n-f;start++)
        {
            ok=1;

            for(i=start;i<start+f;i++)
                if(i>=n)
                    ok=0;

            if(ok)
                break;
        }

        if(ok)
            for(i=start;i<start+f;i++)
                printf("%d ",i);
        else
            printf("Allocation failed");
    }

    else if(m==2)
    {
        for(i=0;i<f;i++)
            printf("%d ",i);
    }

    else if(m==3)
    {
        printf("Index: 0\n");

        for(i=1;i<=f;i++)
            printf("%d ",i);
    }

    return 0;
}



2nd QUESTION

#include <stdio.h>

int main()
{
    int b[20],n,r,i,x;

    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%d",&b[i]);

    scanf("%d",&r);

    for(i=0;i<n && r>0;i++)
    {
        if(b[i]==0)
        {
            b[i]=1;
            r--;
        }
    }

    printf("After allocation: ");

    for(i=0;i<n;i++)
        printf("%d ",b[i]);

    scanf("%d",&x);

    b[x]=0;

    printf("\nAfter deallocation: ");

    for(i=0;i<n;i++)
        printf("%d ",b[i]);

    return 0;
}

3RD QUESTION

#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[10],n,h,d,i,j,x,total;

    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%d",&a[i]);

    scanf("%d%d",&h,&d);

    x=h;
    total=0;

    printf("FCFS: ");

    for(i=0;i<n;i++)
    {
        total=total+abs(x-a[i]);
        x=a[i];
        printf("%d ",x);
    }

    printf("\nSeek time = %d",total);

    return 0;
}

