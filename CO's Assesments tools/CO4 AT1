#include<stdio.h>
#include<stdlib.h>

int main()
{
 int a[20],n,h,d,i,j,t,x,z=0;
 scanf("%d",&n);
 for(i=0;i<n;i++)scanf("%d",&a[i]);
 scanf("%d%d",&h,&d);

 for(i=0;i<n;i++)
  for(j=i+1;j<n;j++)
   if(a[i]>a[j])
   {t=a[i];a[i]=a[j];a[j]=t;}

 x=h;
 printf("C-SCAN: ");
 for(i=0;i<n;i++)
  if(a[i]>=h){z+=abs(x-a[i]);x=a[i];printf("%d ",x);}
 z+=d-1-x+d-1;
 printf("%d 0 ",d-1);
 x=0;
 for(i=0;i<n;i++)
  if(a[i]<h){z+=abs(x-a[i]);x=a[i];printf("%d ",x);}
 printf("\nC-SCAN=%d",z);

 x=h;z=0;
 printf("\nLOOK: ");
 for(i=0;i<n;i++)
  if(a[i]>=h){z+=abs(x-a[i]);x=a[i];printf("%d ",x);}
 for(i=n-1;i>=0;i--)
  if(a[i]<h){z+=abs(x-a[i]);x=a[i];printf("%d ",x);}
 printf("\nLOOK=%d",z);
}


